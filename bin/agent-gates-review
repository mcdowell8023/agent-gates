#!/usr/bin/env bash
# agent-gates-review — capability-aware cross-review router.
#
# Reads ~/.agent-gates/review-capability.json to determine the machine's review
# capability level (L0-L3), then routes to the best available heterogeneous tool.
#
# Usage:  agent-gates-review <prompt-file> [--result <result-file>]
#
# Routing:
#   L3 (opencode+codex): opencode → fallback codex
#   L2 (opencode):       opencode → exit 75
#   L1 (codex/omc):      codex exec → exit 75
#   L0 (none):           exit 78 + warning (same-model only)
#
# Exit codes:
#   0   review completed with heterogeneous tool
#   69  not installed (no review-capability.json)
#   75  review tool failed (caller should fall back to agent-tool)
#   76  prompt too long for opencode and no codex fallback
#   78  L0 machine — no heterogeneous tool available
#
# Env:
#   AGENT_GATES_DIR       override ~/.agent-gates
#   OC_REVIEW_OPENCODE    opencode binary (passed to oc-review)
#   OC_REVIEW_RETRIES     oc-review retry count
#   AG_REVIEW_CODEX       codex binary (default "codex")
#   AG_REVIEW_MODEL       opencode model (default "github-copilot/gpt-5.5")
#   AG_REVIEW_MAX_CHARS   opencode prompt char limit (default 800). Legacy L0-L3 routing
#                         only — the hetero branch does not gate on prompt length.
#   AG_REVIEW_TIMEOUT     seconds allowed per reviewer invocation (default 300). Applies
#                         to opencode and codex alike; exceeding it is reported as a
#                         timeout rather than left to hang.
#
# Source: https://github.com/mcdowell8023/agent-gates
set -uo pipefail

GATES_DIR="${AGENT_GATES_DIR:-$HOME/.agent-gates}"
if [[ -f "$GATES_DIR/hetero-check.json" ]]; then
  CAP_FILE="$GATES_DIR/hetero-check.json"
else
  CAP_FILE="$GATES_DIR/review-capability.json"
fi
CODEX="${AG_REVIEW_CODEX:-codex}"
MODEL="${AG_REVIEW_MODEL:-github-copilot/gpt-5.5}"
MAX_CHARS="${AG_REVIEW_MAX_CHARS:-800}"

# v2.0.2: every external reviewer invocation is bounded. bin/with-timeout.mjs shipped
# since v1.x but had zero call sites, so a reviewer that never returned hung the whole
# gate — one observed run burned 80 minutes and produced nothing at exit 0.
_WT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/with-timeout.mjs"
TIMEOUT_SECS="${AG_REVIEW_TIMEOUT:-120}"
if [[ ! -f "$_WT" ]] || ! command -v node >/dev/null 2>&1; then
  # fail-closed rather than fail-open: silently dropping the timeout would restore the
  # original hang risk while the code still claims every invocation is bounded.
  echo "agent-gates-review: timeout wrapper unavailable ($_WT, node required) — refusing to run reviewers unbounded (fail-closed)" >&2
  exit 75
fi
TIMEOUT_CMD=(node "$_WT" "$TIMEOUT_SECS")

PROMPT_FILE=""
RESULT_FILE=""
ROUTE=""
DISPATCH_OUT=""
IMPORT_RESULT=""
IMPORT_TOKEN=""
PASEO_AGENT=""
IMPORTED_MODEL=""

_need_val() { [[ $2 -ge 2 ]] || { echo "agent-gates-review: $1 requires a value" >&2; exit 1; }; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --result)         _need_val "$1" $#; RESULT_FILE="$2";   shift 2 ;;
    --route)          _need_val "$1" $#; ROUTE="$2";         shift 2 ;;
    --dispatch-out)   _need_val "$1" $#; DISPATCH_OUT="$2";  shift 2 ;;
    --import-result)  _need_val "$1" $#; IMPORT_RESULT="$2"; shift 2 ;;
    --token)          _need_val "$1" $#; IMPORT_TOKEN="$2";  shift 2 ;;
    --paseo-agent)    _need_val "$1" $#; PASEO_AGENT="$2";   shift 2 ;;
    --imported-model) _need_val "$1" $#; IMPORTED_MODEL="$2"; shift 2 ;;
    *)
      if [[ -z "$PROMPT_FILE" ]]; then PROMPT_FILE="$1"; shift
      else echo "agent-gates-review: unknown arg: $1" >&2; exit 1; fi ;;
  esac
done

# Import mode takes no prompt file: the prompt was snapshotted at dispatch time and the
# snapshot — not whatever the path holds now — is what gets verified.
if [[ -z "$IMPORT_RESULT" ]] && [[ -z "$PROMPT_FILE" || ! -f "$PROMPT_FILE" ]]; then
  echo "Usage: agent-gates-review <prompt-file> [--result <file>] [--route paseo --dispatch-out <file>]" >&2
  echo "       agent-gates-review --import-result <review.md> --token <token> --paseo-agent <id> [--result <file>]" >&2
  exit 1
fi

if [[ ! -f "$CAP_FILE" ]]; then
  echo "agent-gates-review: review-capability.json not found at $CAP_FILE — run install.sh or doctor.sh first" >&2
  exit 69
fi
if [[ -n "$IMPORT_RESULT" ]]; then
  PROMPT_CONTENT=""
else
  PROMPT_CONTENT="$(cat "$PROMPT_FILE")"
fi
PROMPT_LEN=${#PROMPT_CONTENT}

LEVEL=$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(d['level'])" "$CAP_FILE" 2>/dev/null || echo "L0")

# --- Helpers ---

sha256_stream() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  else
    shasum -a 256 | awk '{print $1}'
  fi
}

review_staged_files() {
  git -c core.quotePath=true diff --cached --name-only --diff-filter=ACMRD -- \
    . \
    ':(exclude).agent/reviews/**' \
    ':(exclude).agent/verify/**' \
    ':(exclude).agent/plans/**'
}

review_staged_diff_sha256() {
  git diff --cached --binary -- \
    . \
    ':(exclude).agent/reviews/**' \
    ':(exclude).agent/verify/**' \
    ':(exclude).agent/plans/**' \
    | sha256_stream
}

REVIEW_ANCHOR_ENABLED=0
REVIEW_ANCHOR_HEAD=""
REVIEW_ANCHOR_FILES=""
REVIEW_ANCHOR_FILES_SHA256=""
REVIEW_ANCHOR_DIFF_SHA256=""

capture_review_anchor() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0

  local files
  files=$(review_staged_files)
  [[ -n "$files" ]] || return 0

  REVIEW_ANCHOR_ENABLED=1
  REVIEW_ANCHOR_HEAD=$(git rev-parse HEAD 2>/dev/null || echo "")
  REVIEW_ANCHOR_FILES="$files"
  REVIEW_ANCHOR_FILES_SHA256=$(printf '%s\n' "$files" | sha256_stream)
  REVIEW_ANCHOR_DIFF_SHA256=$(review_staged_diff_sha256)
}

review_anchor_is_unchanged() {
  [[ "$REVIEW_ANCHOR_ENABLED" -eq 1 ]] || return 0

  local current_head current_files current_files_sha256 current_diff_sha256
  current_head=$(git rev-parse HEAD 2>/dev/null || echo "")
  current_files=$(review_staged_files)
  current_files_sha256=$(printf '%s\n' "$current_files" | sha256_stream)
  current_diff_sha256=$(review_staged_diff_sha256)

  if [[ "$current_head" != "$REVIEW_ANCHOR_HEAD" \
     || "$current_files_sha256" != "$REVIEW_ANCHOR_FILES_SHA256" \
     || "$current_diff_sha256" != "$REVIEW_ANCHOR_DIFF_SHA256" ]]; then
    echo "agent-gates-review: staged content changed while review was running — refusing stale evidence" >&2
    return 74
  fi
}

append_marker() {
  local tool="$1" model="$2" content="$3"
  review_anchor_is_unchanged || return $?

  printf '%s\n\n<!-- REVIEW_TOOL: %s -->\n<!-- REVIEW_MODEL: %s -->\n<!-- REVIEW_LEVEL: %s -->\n' "$content" "$tool" "$model" "$LEVEL"
  if [[ "$REVIEW_ANCHOR_ENABLED" -eq 1 ]]; then
    printf '<!-- REVIEW_HEAD: %s -->\n' "$REVIEW_ANCHOR_HEAD"
    while IFS= read -r reviewed_file; do
      printf '<!-- REVIEW_FILE: %s -->\n' "$reviewed_file"
    done <<< "$REVIEW_ANCHOR_FILES"
    printf '<!-- REVIEW_FILES_SHA256: %s -->\n' "$REVIEW_ANCHOR_FILES_SHA256"
    printf '<!-- REVIEW_DIFF_SHA256: %s -->\n' "$REVIEW_ANCHOR_DIFF_SHA256"
  fi
}

output_result() {
  local content="$1"
  if [[ -n "$RESULT_FILE" ]]; then
    printf '%s\n' "$content" > "$RESULT_FILE"
  else
    printf '%s\n' "$content"
  fi
}

parse_opencode_json() {
  python3 -c "
import sys, json
for line in sys.stdin:
    line = line.strip()
    if not line: continue
    try:
        obj = json.loads(line)
        if obj.get('type') == 'text':
            print(obj.get('part', {}).get('text', ''), end='')
    except:
        pass
"
}

# Accept a VERDICT line even when the model wraps it in ordinary markdown. Models
# routinely emit `**VERDICT: PASS**`, `## VERDICT: PASS`, a list item, a blockquote,
# backticks, or a full-width colon in Chinese contexts. Before v2.0.2 every one of
# those was rejected and then reported as "all review models failed", which pointed
# troubleshooting at the transport instead of the formatting and cost a full day.
#
# Tolerated: leading blanks, any run of # > * _ ` - before the keyword, ASCII ':' or
# full-width '：', and * _ ` around the value.
#
# Accepted values are listed in full rather than matched as prefixes, and the line must
# carry nothing but the value. Prefix matching reads as harmless — it lets `FAILED` count
# as `FAIL` — but it also lets `VERDICT: PASS_WITH_ISSUES` count as a clean PASS, which
# inverts the review's meaning. A mere word boundary is not enough either: it still admits
# `PASS-WITH-ISSUES` and `PASS.WITH.ISSUES`, the same inversion with different punctuation.
# So after the value only decoration is allowed (* ` blanks, a trailing period) up to end
# of line. That matches what the docs ask the prompt for — a line that is *only* the
# verdict — and a qualified verdict now fails loudly instead of silently reading as PASS.
#
# Still rejected: values outside the list (VERDICT: OK, VERDICT: NEEDS_WORK), qualified
# verdicts of any punctuation, and text with no VERDICT line.
# POSIX classes only — \s is a GNU extension and this ships to other platforms.
has_valid_conclusion() {
  local text="$1"
  echo "$text" | grep -qiE '^[[:blank:]]*[#>*_`[:blank:]-]*VERDICT[[:blank:]]*(:|：)[[:blank:]]*[*`]*(PASS|PASSED|REVISE|REVISED|FAIL|FAILED|ISSUES|ISSUES_FOUND|APPROVED|APPROVE|REJECT|REJECTED)[*`[:blank:].]*$' && return 0
  return 1
}

capture_review_anchor

# --- v1.12.0: review model selection (new fallback chain path) ---

_has_review_models() {
  python3 -c "
import json,sys
d=json.load(open(sys.argv[1]))
sys.exit(0 if ('hetero_models' in d or 'review_models' in d) else 1)
" "$CAP_FILE" 2>/dev/null
}

_get_review_models_key() {
  python3 -c "
import json,sys
d=json.load(open(sys.argv[1]))
print('hetero_models' if 'hetero_models' in d else 'review_models')
" "$CAP_FILE" 2>/dev/null
}

# v2.0.2: wrapped in a function so it runs AFTER PREFERRED/FALLBACK and
# run_opencode/run_codex exist. It used to execute inline right here, which is the
# real reason the hetero path could never reach the codex fallback — run_codex is
# defined further down the file and simply did not exist yet at this point.
run_hetero_review() {
  _BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  source "$_BIN_DIR/../lib/hetero/select.sh"
  _RM_KEY=$(_get_review_models_key)

  _RM_PRIMARY=$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(d[sys.argv[2]]['primary'])" "$CAP_FILE" "$_RM_KEY" 2>/dev/null)
  if [[ -z "$_RM_PRIMARY" ]]; then
    echo "agent-gates-review: review_models.primary is empty or missing" >&2
    exit 75
  fi
  _RM_PANEL_MODE=$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(d[sys.argv[2]].get('panel_mode','auto'))" "$CAP_FILE" "$_RM_KEY" 2>/dev/null)
  _RM_PANEL_CSV=""

  _AUTO_PANEL_THRESHOLD=500
  if [[ "$_RM_PANEL_MODE" == "always" ]] || \
     { [[ "$_RM_PANEL_MODE" == "auto" ]] && [[ $PROMPT_LEN -ge $_AUTO_PANEL_THRESHOLD ]]; }; then
    _RM_PANEL_CSV=$(python3 -c "
import json, sys
d = json.load(open(sys.argv[1]))
rm = d[sys.argv[2]]
pool = rm.get('panel_pool', [])[:rm.get('panel_active', 2)]
print(','.join(pool))
" "$CAP_FILE" "$_RM_KEY" 2>/dev/null)
  fi

  _err_file=$(mktemp)

  if [[ "$_RM_PANEL_MODE" == "off" ]]; then
    _raw_output=$(_try_review_model "$_RM_PRIMARY" "$PROMPT_CONTENT" 2>"$_err_file")
    _rc=$?
  else
    _raw_output=$(run_fallback_chain \
      --primary "$_RM_PRIMARY" \
      --panel "$_RM_PANEL_CSV" \
      --prompt "$PROMPT_CONTENT" 2>"$_err_file")
    _rc=$?
  fi

  if [[ $_rc -eq 0 && -n "$_raw_output" ]]; then
    _parsed=$(echo "$_raw_output" | parse_opencode_json)
    if [[ -n "$_parsed" ]] && has_valid_conclusion "$_parsed"; then
      _actual_model="${_REVIEW_MODEL_USED:-$_RM_PRIMARY}"
      _result=$(append_marker "opencode" "$_actual_model" "$_parsed")
      _marker_rc=$?
      [[ $_marker_rc -eq 0 ]] || exit "$_marker_rc"
      output_result "$_result"
      rm -f "$_err_file"
      exit 0
    fi
  fi

  _hetero_err=$(cat "$_err_file")
  rm -f "$_err_file"

  # Per-model reasons first: each `review-fail[<model>]:` line says which model failed
  # and why (timed out / exited N / empty output / no VERDICT line, with the model's own
  # words quoted). The HETERO_EXHAUSTED summary still follows it, so anything already
  # grepping for that keyword keeps working.
  [[ -n "$_hetero_err" ]] && printf '%s\n' "$_hetero_err" >&2
  # run_fallback_chain already emits its own HETERO_EXHAUSTED line, so only add the summary
  # when that path was bypassed — panel_mode=off calls _try_review_model directly and it
  # reports per-model reasons only. Printing unconditionally duplicated the line.
  if ! printf '%s' "$_hetero_err" | grep -q 'HETERO_EXHAUSTED'; then
    echo "HETERO_EXHAUSTED: all review models failed (primary=$_RM_PRIMARY, panel=$_RM_PANEL_CSV)" >&2
  fi

  # v2.0.2: this used to `exit 75` on the spot, which made fallback_route dead config —
  # codex was unreachable from the hetero path regardless of what the JSON said.
  if [[ "$FALLBACK" == "codex" ]] && command -v "$CODEX" >/dev/null 2>&1; then
    echo "agent-gates-review: falling back to $FALLBACK" >&2
    if run_codex; then
      exit 0
    fi
    echo "agent-gates-review: codex fallback also failed" >&2
  fi

  # Write the stub only once the fallback is out too, otherwise a successful codex
  # review would be overwritten by an HETERO_EXHAUSTED marker.
  if [[ -n "$RESULT_FILE" ]]; then
    echo "<!-- HETERO_EXHAUSTED: primary=$_RM_PRIMARY, panel=$_RM_PANEL_CSV -->" > "$RESULT_FILE"
  fi
  exit 75
}

# --- Legacy L0-L3 routing (no review_models in cap) ---

PREFERRED=$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(d['preferred_route'])" "$CAP_FILE" 2>/dev/null || echo "agent-tool")
FALLBACK=$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(d.get('fallback_route','agent-tool'))" "$CAP_FILE" 2>/dev/null || echo "agent-tool")

# --- Review runners ---

run_opencode() {
  local opencode_bin="${OC_REVIEW_OPENCODE:-opencode}"
  local oc_review="$GATES_DIR/bin/oc-review"

  local raw rc
  if [[ -x "$oc_review" && -z "${OC_REVIEW_OPENCODE:-}" ]]; then
    raw=$("$oc_review" run -m "$MODEL" --dir "${PWD}" --format json "$PROMPT_CONTENT" 2>/dev/null)
    rc=$?
  else
    local _ro_script_dir
    _ro_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [[ -z "${_OC_SERVE_SOURCED:-}" && -f "$_ro_script_dir/../lib/hetero/serve.sh" ]]; then
      source "$_ro_script_dir/../lib/hetero/serve.sh"
    fi
    if ! oc_serve_ensure 2>/dev/null; then
      return 1
    fi
    raw=$(${TIMEOUT_CMD[@]+"${TIMEOUT_CMD[@]}"} "$opencode_bin" run --attach "$OC_SERVE_URL" -m "$MODEL" --dir "${PWD}" --format json "$PROMPT_CONTENT" 2>/dev/null)
    rc=$?
  fi

  # v2.0.2: these four outcomes used to collapse into a bare `return 1`, so the caller
  # could only say "review failed" — which is what sent a day of troubleshooting at the
  # transport when the real problem was prompt formatting. Keep them distinguishable.
  if [[ $rc -eq 124 ]]; then
    echo "agent-gates-review: opencode timed out after ${TIMEOUT_SECS}s (model=$MODEL)" >&2
    return 1
  fi
  if [[ $rc -ne 0 ]]; then
    echo "agent-gates-review: opencode exited $rc (model=$MODEL)" >&2
    return 1
  fi
  if [[ -z "$raw" ]] || ! echo "$raw" | grep -q '[^[:space:]]'; then
    echo "agent-gates-review: opencode exited 0 but produced empty output (model=$MODEL)" >&2
    return 1
  fi

  local parsed
  parsed=$(echo "$raw" | parse_opencode_json)

  if [[ -z "$parsed" ]] || ! echo "$parsed" | grep -q '[^[:space:]]'; then
    echo "agent-gates-review: opencode returned ${#raw} bytes but NDJSON parsed to empty text (model=$MODEL)" >&2
    return 1
  fi

  if ! has_valid_conclusion "$parsed"; then
    echo "agent-gates-review: model answered ${#parsed} chars but produced no VERDICT line (model=$MODEL) — the prompt must require a line matching 'VERDICT: PASS|REVISE|FAIL|ISSUES|APPROVED|REJECT'. Model said: $(printf '%.200s' "$parsed" | tr '\n' ' ')" >&2
    return 1
  fi

  local result
  result=$(append_marker "opencode" "$MODEL" "$parsed")
  local marker_rc=$?
  [[ $marker_rc -eq 0 ]] || return "$marker_rc"
  output_result "$result"
  return 0
}

run_codex() {
  local raw
  # Bounded for the same reason as opencode — a hung fallback is worse than a failed
  # one, because the caller is already out of alternatives.
  raw=$(${TIMEOUT_CMD[@]+"${TIMEOUT_CMD[@]}"} "$CODEX" exec -s read-only --skip-git-repo-check -C "${PWD}" < "$PROMPT_FILE" 2>/dev/null)
  local rc=$?
  if [[ $rc -eq 124 ]]; then
    echo "agent-gates-review: codex timed out after ${TIMEOUT_SECS}s" >&2
    return 1
  fi
  if [[ $rc -eq 0 && -n "$raw" ]]; then
    local result
    result=$(append_marker "codex" "gpt-5-series" "$raw")
    local marker_rc=$?
    [[ $marker_rc -eq 0 ]] || return "$marker_rc"
    output_result "$result"
    return 0
  fi
  return 1
}

# --- Prompt length gate ---

prompt_too_long_for_opencode() {
  [[ "$PROMPT_LEN" -gt "$MAX_CHARS" ]]
}

# --- paseo external review import channel (v2.1.0) -------------------------
#
# A shell script cannot create a local Paseo agent — `paseo run` tries to launch Electron
# and silently creates nothing (exit 0, absent from `paseo ls`). So dispatch is delegated to
# the calling agent over MCP, and this tool keeps ownership of the part that matters: the
# anchors. Phase 1 captures them and snapshots the prompt; phase 2 re-checks both before
# accepting the result. See docs/plans/2026-08-13-paseo-review-channel.md §4 for exactly
# what this does and does not guarantee — notably it does NOT prove the review text came
# from that agent.

PASEO_BIN="${AG_REVIEW_PASEO:-paseo}"
PASEO_PENDING_DIR="$GATES_DIR/pending-reviews"
PASEO_PROCESSING_DIR="$GATES_DIR/processing"
PASEO_TTL="${AG_REVIEW_PASEO_TTL:-7200}"
PASEO_PROCESSING_STALE="${AG_REVIEW_PROCESSING_STALE:-3600}"

_paseo_mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0; }

_paseo_epoch_of() {
  python3 -c "
import sys, datetime
try:
    print(int(datetime.datetime.fromisoformat(sys.argv[1].replace('Z','+00:00')).timestamp()))
except Exception:
    print(0)
" "$1" 2>/dev/null || echo 0
}

# Whole directories only. An earlier draft kept <token>.json and <token>.prompt side by
# side; claim moved just the record, so snapshots piled up forever. Directory rename is
# atomic, two file renames are not — that is the whole reason for this layout.
# $1: a token to leave alone. The import path passes its own token so that an expired
# record survives long enough to be claimed and reported as "expired" (74) instead of being
# swept first and then reported as "unknown token" (1) — the same collapsing-of-distinct-
# causes that this whole release is about. Everything else still gets cleaned.
paseo_sweep() {
  local keep="${1:-}"
  local now d
  now=$(date +%s)

  if [[ -d "$PASEO_PENDING_DIR" ]]; then
    for d in "$PASEO_PENDING_DIR"/*; do
      [[ -e "$d" ]] || continue
      [[ -n "$keep" && "$(basename "$d")" == "$keep" ]] && continue
      [[ -d "$d" ]] || { rm -f "$d"; continue; }               # stray file from any old layout
      [[ -f "$d/record.json" ]] || { rm -rf "$d"; continue; }  # orphan dir
      local exp; exp=$(python3 -c "
import json,sys,datetime
try:
    r=json.load(open(sys.argv[1]))
    print(int(datetime.datetime.fromisoformat(r['expires_at'].replace('Z','+00:00')).timestamp()))
except Exception:
    print(0)
" "$d/record.json" 2>/dev/null || echo 0)
      [[ "${exp:-0}" -gt 0 && "${exp:-0}" -lt "$now" ]] && rm -rf "$d"
    done
  fi

  # Crash residue: a claim that never finished. Judged by the directory's own mtime (set by
  # the claim rename), never by record.created_at — a token that sat in pending for hours
  # would otherwise be reaped the instant it was claimed.
  if [[ -d "$PASEO_PROCESSING_DIR" ]]; then
    for d in "$PASEO_PROCESSING_DIR"/*; do
      [[ -d "$d" ]] || continue
      local age=$(( now - $(_paseo_mtime "$d") ))
      [[ "$age" -gt "$PASEO_PROCESSING_STALE" ]] || continue
      if [[ -f "$d/record.json" ]]; then
        mkdir -p "$PASEO_PENDING_DIR"
        mv "$d" "$PASEO_PENDING_DIR/$(basename "$d")" 2>/dev/null || rm -rf "$d"
      else
        rm -rf "$d"
      fi
    done
  fi
}

paseo_dispatch() {
  [[ -n "$DISPATCH_OUT" ]] || { echo "agent-gates-review: --route paseo requires --dispatch-out <file>" >&2; exit 1; }

  capture_review_anchor

  local token dir
  token=$(python3 -c "import secrets;print(secrets.token_hex(16))")
  dir="$PASEO_PENDING_DIR/$token"
  mkdir -p "$dir" || { echo "agent-gates-review: cannot create $dir" >&2; exit 1; }

  cp "$PROMPT_FILE" "$dir/prompt" || { rm -rf "$dir"; echo "agent-gates-review: cannot snapshot prompt" >&2; exit 1; }
  local psha; psha=$(sha256_stream < "$dir/prompt")
  printf '%s\n' "$REVIEW_ANCHOR_FILES" > "$dir/files"

  local created expires
  created=$(python3 -c "import datetime;print(datetime.datetime.now(datetime.timezone.utc).isoformat())")
  expires=$(python3 -c "
import datetime,sys
print((datetime.datetime.now(datetime.timezone.utc)+datetime.timedelta(seconds=int(sys.argv[1]))).isoformat())
" "$PASEO_TTL")

  python3 - "$dir/record.json" "$token" "$psha" "$created" "$expires" "$PWD" \
    "$REVIEW_ANCHOR_ENABLED" "$REVIEW_ANCHOR_HEAD" "$REVIEW_ANCHOR_FILES_SHA256" "$REVIEW_ANCHOR_DIFF_SHA256" <<'PY'
import json, sys
p, token, psha, created, expires, cwd, en, head, fsha, dsha = sys.argv[1:11]
json.dump({
    "token": token, "prompt_sha256": psha, "created_at": created, "expires_at": expires,
    "cwd": cwd,
    "anchor": {"enabled": int(en), "head": head, "files_sha256": fsha, "diff_sha256": dsha},
}, open(p, "w"), indent=2)
PY

  # Write the request last: if it fails there must be no dangling token left behind.
  if ! python3 - "$DISPATCH_OUT" "$token" "$dir/prompt" "$psha" "$expires" <<'PY'
import json, sys
out, token, prompt_file, psha, expires = sys.argv[1:6]
req = {
    "token": token,
    "prompt_file": prompt_file,
    "prompt_sha256": psha,
    "suggested": {
        "provider": "opencode/github-copilot/gpt-5.5",
        "alternatives": ["codex/gpt-5.5", "codebuddy-code/deepseek-v4-pro"],
    },
    "requirements": {
        "read_only": True,
        "verdict_line": "最后一行必须是裸行 VERDICT: PASS / ISSUES / FAIL（无 markdown 装饰、无缩进、英文半角冒号）",
        "note": "结论行只能承载取值本身，PASS_WITH_ISSUES 之类会被拒",
        "heterogeneous": "provider 不能是 claude —— 同模型审查不算异构审查",
    },
    "expires_at": expires,
    "import_cmd": f"agent-gates-review --import-result <review.md> --token {token} --paseo-agent <agent-id> --result <out>",
}
json.dump(req, open(out, "w"), ensure_ascii=False, indent=2)
PY
  then
    rm -rf "$dir"
    echo "agent-gates-review: cannot write dispatch request to $DISPATCH_OUT — no pending record left behind" >&2
    exit 1
  fi

  echo "agent-gates-review: dispatch request written to $DISPATCH_OUT (token ${token:0:8}…)" >&2
  echo "  next: have the calling agent create a Paseo sub-session per 'suggested', then run 'import_cmd'" >&2
  exit 77
}

# Verify a Paseo agent really exists, is heterogeneous, and postdates the dispatch.
# Prints "<provider>/<model>" on success. Exit codes distinguish the reasons so the caller
# can say which check failed.
_paseo_verify_agent() {
  local agent_id="$1" dispatched_at="$2"
  command -v "$PASEO_BIN" >/dev/null 2>&1 || return 2

  # `agent inspect`, not `agent ls`. Verified against paseo 0.1.x: `ls --json` reports
  # `created` as a relative string ("4 minutes ago"), which cannot establish ordering at all,
  # while `inspect --json` returns an absolute ISO8601 `CreatedAt`. The two also disagree on
  # casing (camelCase vs PascalCase) and on whether provider and model are one field or two —
  # an end-to-end run is what surfaced this; fakes built from the MCP tool's field names had
  # every test passing against a shape the CLI never emits.
  #
  # ⚠️ inspect exits 0 even for an unknown id, so absence must be read off the payload.
  #
  # The payload goes to a file, not down a pipe: `python3 -` reads its *script* from stdin, so
  # a heredoc script and piped data fight over the same fd — the heredoc wins and the script
  # sees empty stdin.
  local tmpj; tmpj=$(mktemp)
  if ! "${TIMEOUT_CMD[@]}" "$PASEO_BIN" agent inspect "$agent_id" --json >"$tmpj" 2>/dev/null; then
    rm -f "$tmpj"; return 3
  fi

  local out prc=0
  out=$(python3 - "$tmpj" "$dispatched_at" <<'PY'
import json, sys, datetime
path, dispatched = sys.argv[1:3]
try:
    d = json.load(open(path))
except Exception:
    sys.exit(4)                      # no usable payload == unknown agent
if not isinstance(d, dict) or not d.get("Id"):
    sys.exit(4)
prov = (d.get("Provider") or "")
if not prov:
    sys.exit(7)
if "claude" in prov.lower():
    sys.exit(5)
def ts(t):
    try: return datetime.datetime.fromisoformat((t or "").replace("Z", "+00:00"))
    except Exception: return None
ca, da = ts(d.get("CreatedAt")), ts(dispatched)
# Fail closed: if either timestamp is missing or unparseable we cannot establish that the
# agent postdates the dispatch, and "cannot tell" must not read as "fine".
if ca is None or da is None:
    sys.exit(8)
if ca < da:
    sys.exit(6)
print(f'{prov}/{d.get("Model","?")}')
PY
  ) || prc=$?
  rm -f "$tmpj"
  [[ $prc -eq 0 ]] || return $prc
  printf '%s' "$out"
}

paseo_import() {
  [[ -n "$IMPORT_TOKEN" ]] || { echo "agent-gates-review: --import-result requires --token" >&2; exit 1; }
  [[ -f "$IMPORT_RESULT" && -s "$IMPORT_RESULT" ]] || { echo "agent-gates-review: review file missing or empty: $IMPORT_RESULT" >&2; exit 75; }
  # The channel is not prescribed: any reviewer can be imported. --paseo-agent additionally
  # proves a heterogeneous Paseo agent existed; without it the import still works but the
  # product is marked unverified, and --imported-model must at least say what produced it.
  if [[ -z "$PASEO_AGENT" && -z "$IMPORTED_MODEL" ]]; then
    echo "agent-gates-review: --import-result needs either --paseo-agent <id> (verified) or --imported-model <id> (declared, recorded as unverified)" >&2
    exit 1
  fi

  local pend="$PASEO_PENDING_DIR/$IMPORT_TOKEN" proc="$PASEO_PROCESSING_DIR/$IMPORT_TOKEN"
  mkdir -p "$PASEO_PROCESSING_DIR"
  # Atomic claim. Whoever wins the rename owns the token; everyone else fails here.
  mv "$pend" "$proc" 2>/dev/null || {
    echo "agent-gates-review: unknown, expired or already-claimed token" >&2; exit 1; }

  local rec="$proc/record.json"
  [[ -f "$rec" ]] || { rm -rf "$proc"; echo "agent-gates-review: pending record missing" >&2; exit 1; }

  local fields
  fields=$(python3 -c "
import json,sys
r=json.load(open(sys.argv[1]))
a=r['anchor']
print(r['prompt_sha256']); print(r['expires_at']); print(r['created_at'])
print(a['enabled']); print(a['head']); print(a['files_sha256']); print(a['diff_sha256'])
" "$rec" 2>/dev/null) || { rm -rf "$proc"; echo "agent-gates-review: pending record is corrupt or incomplete" >&2; exit 1; }

  local rec_psha rec_exp rec_created
  { read -r rec_psha; read -r rec_exp; read -r rec_created
    read -r REVIEW_ANCHOR_ENABLED; read -r REVIEW_ANCHOR_HEAD
    read -r REVIEW_ANCHOR_FILES_SHA256; read -r REVIEW_ANCHOR_DIFF_SHA256; } <<< "$fields"

  local now exp_epoch
  now=$(date +%s); exp_epoch=$(_paseo_epoch_of "$rec_exp")
  if [[ "${exp_epoch:-0}" -gt 0 && "${exp_epoch:-0}" -lt "$now" ]]; then
    rm -rf "$proc"; echo "agent-gates-review: token expired at $rec_exp — dispatch again" >&2; exit 74
  fi

  local cur_psha; cur_psha=$(sha256_stream < "$proc/prompt" 2>/dev/null)
  if [[ "$cur_psha" != "$rec_psha" ]]; then
    rm -rf "$proc"
    echo "agent-gates-review: prompt snapshot no longer matches its recorded hash — the reviewed material was tampered with; dispatch again" >&2
    exit 74
  fi

  REVIEW_ANCHOR_FILES=$(cat "$proc/files" 2>/dev/null)

  # Anchor check goes BEFORE the recoverable checks, matching the plan's ordering. Leaving it
  # to append_marker at the very end meant that "staged moved AND the agent is invalid" took
  # the agent branch and bounced the token back to pending — inviting retries that can never
  # succeed, because a moved anchor never comes back. Unrecoverable checks first.
  local arc=0
  review_anchor_is_unchanged || arc=$?
  if [[ $arc -ne 0 ]]; then
    rm -rf "$proc"
    exit "$arc"
  fi

  local agent_desc="" vrc=0 review_tool="paseo"
  if [[ -z "$PASEO_AGENT" ]]; then
    # Declared-only import: no Paseo agent to check against, so say so in the product rather
    # than let it read like a verified one. The anchors still hold — what is missing is any
    # evidence about *who* reviewed.
    review_tool="external"
    agent_desc="${IMPORTED_MODEL} (unverified)"
    echo "agent-gates-review: importing without agent verification — recorded as REVIEW_TOOL: external, model '${IMPORTED_MODEL}' marked unverified" >&2
  else
  agent_desc=$(_paseo_verify_agent "$PASEO_AGENT" "$rec_created") || vrc=$?
  if [[ $vrc -ne 0 ]]; then
    mv "$proc" "$pend" 2>/dev/null   # recoverable: dispatch another agent and retry
    case $vrc in
      2) echo "agent-gates-review: paseo binary not found ($PASEO_BIN) — cannot verify the reviewing agent" >&2 ;;
      3) echo "agent-gates-review: 'paseo agent ls --json' failed — cannot verify the reviewing agent" >&2 ;;
      7) echo "agent-gates-review: could not parse 'paseo agent ls --json' output — cannot verify the reviewing agent" >&2 ;;
      4) echo "agent-gates-review: paseo agent '$PASEO_AGENT' not found — verification failed" >&2 ;;
      5) echo "agent-gates-review: paseo agent '$PASEO_AGENT' runs a claude provider — same-model review does not count as heterogeneous" >&2 ;;
      6) echo "agent-gates-review: paseo agent '$PASEO_AGENT' was created before this review was dispatched — an older agent cannot vouch for it" >&2 ;;
      8) echo "agent-gates-review: paseo agent '$PASEO_AGENT' has no usable createdAt — cannot establish that it postdates the dispatch (fail-closed)" >&2 ;;
      *) echo "agent-gates-review: paseo agent verification failed (rc=$vrc)" >&2 ;;
    esac
    exit 75
  fi
  fi

  local body; body=$(cat "$IMPORT_RESULT")
  if ! has_valid_conclusion "$body"; then
    mv "$proc" "$pend" 2>/dev/null   # recoverable: ask for a conclusion line and retry
    echo "agent-gates-review: imported review produced no VERDICT line — the reviewer's prompt must require a line matching 'VERDICT: PASS|REVISE|FAIL|ISSUES|APPROVED|REJECT'. Review said: $(printf '%.200s' "$body" | tr '\n' ' ')" >&2
    exit 75
  fi

  # append_marker re-checks the anchors it was given against the current staged state, so
  # the "staged must not have moved" guarantee is the same code path the other routes use.
  local product mrc=0
  product=$(append_marker "$review_tool" "$agent_desc" "$body") || mrc=$?
  if [[ $mrc -ne 0 ]]; then
    rm -rf "$proc"   # anchors moved: unrecoverable
    exit "$mrc"
  fi

  output_result "$product"
  rm -rf "$proc"
  exit 0
}

# --- Main routing ---

paseo_sweep "$IMPORT_TOKEN"

if [[ -n "$IMPORT_RESULT" ]]; then
  paseo_import
fi

if [[ "$ROUTE" == "paseo" ]]; then
  paseo_dispatch
fi

# Hetero selection is invoked here rather than at its definition site so every helper
# it needs already exists. It exits on both success and exhaustion, so control reaches
# the legacy case below only when the capability file carries no review_models segment.
if _has_review_models; then
  run_hetero_review
fi

case "$LEVEL" in
  L3)
    if prompt_too_long_for_opencode; then
      echo "agent-gates-review: prompt too long for opencode (${PROMPT_LEN} > ${MAX_CHARS} chars), routing to codex" >&2
      run_codex
      _route_rc=$?
      [[ $_route_rc -eq 0 ]] && exit 0
      [[ $_route_rc -eq 74 ]] && exit 74
      echo "agent-gates-review: codex also failed" >&2
      exit 75
    fi
    run_opencode
    _route_rc=$?
    [[ $_route_rc -eq 0 ]] && exit 0
    [[ $_route_rc -eq 74 ]] && exit 74
    echo "agent-gates-review: opencode failed, falling back to codex" >&2
    run_codex
    _route_rc=$?
    [[ $_route_rc -eq 0 ]] && exit 0
    [[ $_route_rc -eq 74 ]] && exit 74
    echo "agent-gates-review: both opencode and codex failed" >&2
    exit 75
    ;;
  L2)
    if prompt_too_long_for_opencode; then
      echo "agent-gates-review: prompt too long for opencode (${PROMPT_LEN} > ${MAX_CHARS} chars) and no codex fallback (L2). Shorten prompt to ≤${MAX_CHARS} chars or install codex for L3." >&2
      exit 76
    fi
    run_opencode
    _route_rc=$?
    [[ $_route_rc -eq 0 ]] && exit 0
    [[ $_route_rc -eq 74 ]] && exit 74
    echo "agent-gates-review: opencode failed (L2, no codex fallback)" >&2
    exit 75
    ;;
  L1)
    if [[ "$PREFERRED" == "omc-codex-plugin" ]]; then
      echo "agent-gates-review: L1 via omc-codex-plugin — this is an agent-based route, not CLI-drivable." >&2
      echo "  Use the OMC codex plugin directly: /ask codex or codex:codex-rescue agent." >&2
      exit 78
    fi
    run_codex
    _route_rc=$?
    [[ $_route_rc -eq 0 ]] && exit 0
    [[ $_route_rc -eq 74 ]] && exit 74
    echo "agent-gates-review: codex failed (L1)" >&2
    exit 75
    ;;
  L0|*)
    echo "agent-gates-review: L0 machine — no heterogeneous review tool available. Same-model degraded review only." >&2
    echo "  Install opencode (https://opencode.ai) or codex (npm i -g @openai/codex) to unlock L1+." >&2
    exit 78
    ;;
esac
