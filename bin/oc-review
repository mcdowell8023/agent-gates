#!/usr/bin/env bash
# oc-review — opencode run with retry-on-empty + shared serve (v1.13.0).
# Mitigates the "P2" failure mode where `opencode run` exits 0 but produces EMPTY
# output (observed in both bare and --attach modes). Detects empty output and retries;
# if still empty after retries, exits 75 (EX_TEMPFAIL) with an `oc-review:`-prefixed
# stderr line so the caller can fall back to a different reviewer (e.g. codex) per
# agent-review-protocol §8.
#
# v1.13.0: auto-manages a shared `opencode serve --pure --port 4096` and injects
# `--attach` to route all runs through it, eliminating per-run serve stacking.
# Set OC_SERVE_DISABLED=1 to skip serve integration.
#
# Usage:  oc-review run -m <model> --dir <wd> "<prompt>"
# Env:
#   OC_REVIEW_RETRIES   extra attempts after the first (default 2 → up to 3 total)
#   OC_REVIEW_OPENCODE  opencode binary (default "opencode"; overridable for tests)
#   OC_SERVE_DISABLED   set to 1 to skip shared serve integration
#   AG_REVIEW_TIMEOUT   seconds allowed per attempt (default 120; was 300 until v2.4.1 —
#                       a hang that takes 5 minutes to surface reads as "the gate is broken").
#                       A timeout is not
#                       retried — it exits 75 so the caller can fall back instead.
# Source: https://github.com/mcdowell8023/agent-gates
set -uo pipefail

RETRIES="${OC_REVIEW_RETRIES:-2}"
OPENCODE="${OC_REVIEW_OPENCODE:-opencode}"

# v1.13.0: shared serve integration
_SERVE_ATTACH=()
_OC_SERVE_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/hetero/serve.sh"
if [[ -z "${OC_SERVE_DISABLED:-}" ]]; then
  # F8 fix: if serve integration is expected (OC_SERVE_DISABLED not set) but
  # serve.sh is missing, fail-closed rather than silently bare-running opencode.
  if [[ ! -f "$_OC_SERVE_LIB" ]]; then
    echo "oc-review: serve.sh missing at $_OC_SERVE_LIB — fail-closed; set OC_SERVE_DISABLED=1 to allow bare-run" >&2
    exit 75
  fi
  source "$_OC_SERVE_LIB"
  if oc_serve_ensure 2>/dev/null; then
    # R4: check if --attach already present in args
    _has_attach=false
    for _a in "$@"; do [[ "$_a" == "--attach" ]] && _has_attach=true; done
    if [[ "$_has_attach" == false ]]; then
      _SERVE_ATTACH=(--attach "$OC_SERVE_URL")
    fi
  else
    # fail-closed: serve integration attempted but failed — do NOT bare-run opencode.
    # Exit 75 (EX_TEMPFAIL) so the caller can fall back to a different reviewer.
    echo "oc-review: serve integration failed (oc_serve_ensure returned non-zero) — fail-closed, not bare-running opencode; caller should fall back per agent-review-protocol §8" >&2
    exit 75
  fi
fi

_build_args() {
  local found_run=false
  for arg in "$@"; do
    printf '%s\0' "$arg"
    if [[ "$found_run" == false && "$arg" == "run" ]]; then
      found_run=true
      if [[ ${#_SERVE_ATTACH[@]} -gt 0 ]]; then
        printf '%s\0' "${_SERVE_ATTACH[@]}"
      fi
    fi
  done
}

# v2.4.1: refuse fast when the opencode channel is disabled.
#
# v2.4.0 turned that channel off by default, but only hetero_dispatch consults the flag.
# oc-review is a standalone entry point: called directly — by an agent, a skill, or habit —
# it bypassed the decision entirely, started a shared `opencode serve`, and then blocked for
# the full AG_REVIEW_TIMEOUT. Sessions kept reporting "审查卡住导致任务无法进行" while the
# channel was supposedly disabled.
#
# Five minutes of hanging is strictly worse than an immediate error that names the
# alternative, so this refuses before touching the serve.
_oc_chan_enabled() {
  # env wins, same precedence as config.sh
  if [[ -n "${HETERO_CHAN_OPENCODE:-}" ]]; then
    [[ "$HETERO_CHAN_OPENCODE" == "1" ]]
    return
  fi
  local f="${AGENT_GATES_DIR:-$HOME/.agent-gates}/hetero-check.json"
  # No config file here means "nothing said to disable it" — dispatch applies its own
  # default. This guard only enforces an explicit disable.
  [[ -f "$f" ]] || return 0
  local v
  v=$(python3 -c '
import json,sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
c = (d.get("channels") or {}).get("opencode") or {}
e = c.get("enabled")
print("" if e is None else ("1" if e else "0"))
' "$f" 2>/dev/null)
  [[ "$v" != "0" ]]
}

if ! _oc_chan_enabled; then
  {
    echo "oc-review: the opencode channel is disabled — refusing to start a serve."
    echo "  Why: measured timing out as a review channel — 120s through agent-gates-review,"
    echo "       200s through a manual --attach, and that was with a minimal prompt — while"
    echo "       pi returns in ~7s. Retrying with a narrower prompt does NOT help."
    echo "  Use instead:  pi -p --provider <provider> --model <model> \"<prompt>\""
    echo "                (--provider and --model are two separate flags)"
    echo "  Re-enable:    HETERO_CHAN_OPENCODE=1, or channels.opencode.enabled=true in"
    echo "                \${AGENT_GATES_DIR:-~/.agent-gates}/hetero-check.json"
  } >&2
  exit 69   # EX_UNAVAILABLE
fi

tmp=$(mktemp); errtmp=$(mktemp)
trap 'rm -f "$tmp" "$errtmp"' EXIT

# v2.0.2: bound each attempt. Without this a request that never returns hangs the
# caller indefinitely — and because the retry loop below only reacts to exit codes,
# a hang was never even reached, let alone retried.
_WT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/with-timeout.mjs"
_TIMEOUT_SECS="${AG_REVIEW_TIMEOUT:-120}"
if [[ ! -f "$_WT" ]] || ! command -v node >/dev/null 2>&1; then
  # fail-closed, matching the serve guard above: exit 75 so the caller falls back, rather
  # than quietly running an unbounded opencode that can hang the whole gate.
  echo "oc-review: timeout wrapper unavailable ($_WT, node required) — refusing to run unbounded; caller should fall back per agent-review-protocol §8" >&2
  exit 75
fi
_TIMEOUT_CMD=(node "$_WT" "$_TIMEOUT_SECS")

attempt=0
while :; do
  attempt=$((attempt + 1))

  # Empty-array expansion stays guarded for bash 3.2 (macOS default) under `set -u`.
  if [[ ${#_SERVE_ATTACH[@]} -gt 0 ]]; then
    args=()
    while IFS= read -r -d '' a; do args+=("$a"); done < <(_build_args "$@")
    ${_TIMEOUT_CMD[@]+"${_TIMEOUT_CMD[@]}"} "$OPENCODE" "${args[@]}" > "$tmp" 2>"$errtmp"
  else
    ${_TIMEOUT_CMD[@]+"${_TIMEOUT_CMD[@]}"} "$OPENCODE" "$@" > "$tmp" 2>"$errtmp"
  fi
  rc=$?

  # A timeout is not a flake — retrying just burns another full timeout window.
  if [[ "$rc" -eq 124 ]]; then
    echo "oc-review: opencode timed out after ${_TIMEOUT_SECS}s on attempt $attempt — not retrying; caller should fall back (e.g. codex) per agent-review-protocol §8" >&2
    exit 75
  fi

  has_output=0
  if [[ -s "$tmp" ]] && grep -q '[^[:space:]]' "$tmp"; then has_output=1; fi

  if [[ "$rc" -eq 0 && "$has_output" -eq 1 ]]; then
    cat "$tmp"
    exit 0
  fi

  if [[ "$attempt" -gt "$RETRIES" ]]; then
    if [[ "$rc" -ne 0 ]]; then
      echo "oc-review: opencode exited $rc after $attempt attempt(s)$([[ $has_output -eq 1 ]] && echo ' (partial output discarded)')" >&2
      [[ -s "$errtmp" ]] && sed 's/^/oc-review: opencode stderr: /' "$errtmp" >&2
    else
      echo "oc-review: opencode produced empty output after $attempt attempt(s) — likely the P2 flake; caller should fall back (e.g. codex) per agent-review-protocol §8" >&2
    fi
    exit 75
  fi
  if [[ "$rc" -ne 0 ]]; then
    echo "oc-review: opencode exit $rc, retrying ($attempt/$RETRIES)..." >&2
  else
    echo "oc-review: empty output, retrying ($attempt/$RETRIES)..." >&2
  fi
done
