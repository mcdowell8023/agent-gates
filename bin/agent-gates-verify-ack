#!/usr/bin/env bash
# agent-gates-verify-ack — write USER_ACK for a verify run after human confirmation.
# Usage: agent-gates-verify-ack <verify_run_id> [reason]
#
# Writes .agent/verify/<verify_run_id>.ack binding the current staged diff hash and
# HEAD so the gate can detect stale ACKs when code changes after confirmation.
# The .ack file is NOT git-staged (gate reads it from the working tree).

set -euo pipefail

PROG="$(basename "$0")"
usage() {
  echo "Usage: $PROG <verify_run_id> [reason]"
  echo ""
  echo "  verify_run_id  Basename of the verify document (without .md extension)"
  echo "  reason         Optional description of why user is confirming (default: 'user confirmed')"
  exit 1
}

[[ $# -lt 1 ]] && usage

VERIFY_RUN_ID="$1"
REASON="${2:-user confirmed}"
VERIFY_DIR=".agent/verify"

# An ACK is an authorization record, not an identity proof. This script records no signer
# identity and never could — anyone able to run it can set any environment variable. So
# refusing to run under AGENT_MODE=1 proved nothing; its only real effect was forcing the
# user to cd into the repo and sign by hand, which became the dominant cost once several
# tasks ran in parallel (2026-08-21: repeated manual signing on reviews that had already
# passed).
#
# The gate is on HONESTY instead. An agent signing on the user's behalf must say what was
# authorized, because the default reason would be a false statement. ASK_USER_CONFIRMED=1
# still means a human confirmed and keeps the default reason.
# ASK_USER_CONFIRMED is itself an env var the agent can set, so it must NOT buy a
# "no reason needed" path (cross-review 2026-08-21 #7). Under AGENT_MODE the reason is
# required either way; the flag only changes what the artifact records about the signer.
SIGNED_BY=human
if [[ "${AGENT_MODE:-}" == "1" ]]; then
  [[ "${ASK_USER_CONFIRMED:-}" == "1" ]] || SIGNED_BY=agent
  if [[ $# -lt 2 ]]; then
    echo "$PROG: under AGENT_MODE=1 an explicit reason is required — state what the user authorized." >&2
    echo "  The default reason ('user confirmed') would be untrue when an agent signs." >&2
    echo "  e.g. $PROG ${VERIFY_RUN_ID} 'user approved: e2e blocked on deploy, will run right after commit'" >&2
    exit 1
  fi
fi

# Validate verify document exists
if ! find "$VERIFY_DIR" -maxdepth 1 -name "${VERIFY_RUN_ID}*.md" 2>/dev/null | grep -q .; then
  echo "Error: No verify document matching '${VERIFY_RUN_ID}' found in ${VERIFY_DIR}/" >&2
  echo "       Expected: ${VERIFY_DIR}/${VERIFY_RUN_ID}.md" >&2
  exit 1
fi

# Compute staged diff hash — exclude .agent/verify/ to avoid chicken-and-egg
# (writing the .ack would change what it's supposed to bind)
if command -v sha256sum >/dev/null 2>&1; then
  STAGED_DIFF_HASH=$(git diff --cached -- ':!.agent/verify' | sha256sum | cut -d' ' -f1)
else
  STAGED_DIFF_HASH=$(git diff --cached -- ':!.agent/verify' | shasum -a 256 | cut -d' ' -f1)
fi

# Current HEAD commit
HEAD=$(git rev-parse HEAD 2>/dev/null || echo "")

# ISO 8601 timestamp
TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date +"%Y-%m-%dT%H:%M:%SZ")

ACK_FILE="${VERIFY_DIR}/${VERIFY_RUN_ID}.ack"
ACK_TMP="${ACK_FILE}.tmp.$$"

# Atomic write: write to tmp then rename
cat > "$ACK_TMP" <<EOF
USER_ACK: PROCEED
verify_run_id: ${VERIFY_RUN_ID}
signed_by: ${SIGNED_BY}
staged_diff_hash: ${STAGED_DIFF_HASH}
HEAD: ${HEAD}
reason: ${REASON}
timestamp: ${TIMESTAMP}
EOF

mv "$ACK_TMP" "$ACK_FILE"

echo "✅ ACK written: $ACK_FILE"
echo "   run_id:  $VERIFY_RUN_ID"
echo "   hash:    $STAGED_DIFF_HASH"
echo "   HEAD:    $HEAD"
echo "   signed:  $SIGNED_BY"
echo "   reason:  $REASON"
